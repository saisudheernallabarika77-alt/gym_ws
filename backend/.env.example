# Fitora backend environment - copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# ---- SMTP (Gmail) ----
# false = OTPs print to the console/server log instead of sending real email.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Fitora
SMTP_FROM_EMAIL=

# ---- JWT / security ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ random chars) once ENV=production - the app refuses to start
# in production with a missing or weak value here.
JWT_SECRET=
PASS_QR_SECRET=

# ---- payments ----
PAYMENT_GATEWAY=mock
PLATFORM_UPI_ID=fitora@upi
# Only needed if PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- database ----
# Omit for SQLite (zero-setup local dev). Set for PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/fitora

# ---- environment ----
# development (default) | production
# ENV=production
